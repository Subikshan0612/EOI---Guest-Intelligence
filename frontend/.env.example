# --- KOI frontend environment ---
# Copy to frontend/.env for local development. Do not commit real values.

# Base URL of the KOI backend REST API (Express server + /api prefix).
# Local development default:
VITE_API_BASE_URL=http://localhost:5000/api

# Development-only tenant context. KOI has no authentication yet, so the
# frontend must tell the API which workspace it is acting in.
#
# This must be a REAL workspace ObjectId from your local MongoDB. Create one:
#
#   cd backend
#   MONGODB_URI=<your uri> node scripts/create-dev-workspace.mjs
#
# The script prints the workspace id — paste it below.
#
# When left blank, the frontend runs in LOCAL mode: conversations are stored in
# the browser only and nothing is sent to the backend (Phase 1 behaviour).
# VITE_KOI_WORKSPACE_ID=   (development without sign-in only; leave unset in production)

# Development-only ACCESS TOKEN for the authenticated Decision endpoints.
# EOI has no real sign-in yet. Issue a token with the backend's development tool
# (it reads AUTH_STUB_SECRET from the BACKEND environment; the frontend never
# sees that secret):
#
#   cd backend
#   node scripts/issue-dev-token.mjs --subject <dev-subject>
#
# The subject must belong to a real backend User that has an ACTIVE
# WorkspaceMembership in the workspace above; otherwise the backend refuses it.
# Paste ONLY the token here. It is read in development builds only, is short
# lived, and must never be committed. NEVER put AUTH_STUB_SECRET here.
# VITE_DEV_ACCESS_TOKEN=

# --- Real sign-in (OIDC, Authorization Code + PKCE) - Phase 23 ---------------------------------------------------
# All PUBLIC values. A browser app is a PUBLIC client: there is NO client secret and NO variable for one - never add one
# (anything named VITE_* is shipped to every visitor). The access token is kept in memory only.
# When VITE_OIDC_AUTHORITY and VITE_OIDC_CLIENT_ID are both set, the app signs in through the provider instead of using the dev token.
# VITE_OIDC_AUTHORITY=
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_REDIRECT_URI=
# VITE_OIDC_SCOPE=openid profile email
# VITE_OIDC_AUDIENCE=
# Phase 45B.4 (PUBLIC values, not credentials): for a provider that requires a client secret at its token endpoint (Google 'Web application' client), the browser
# cannot do the code exchange; it posts the code + PKCE verifier to the EOI backend, which holds the secret. And the provider's display name for the button.
# VITE_OIDC_TOKEN_EXCHANGE_URL=http://localhost:5001/api/auth/oidc/token
# VITE_OIDC_PROVIDER_LABEL=Google
# VITE_OIDC_AUTO_REDIRECT=false     # optional: show a "Sign in" screen on a fresh visit instead of redirecting to the provider immediately (default: redirect)

# --- Unified sign-in (Phase 46) ---------------------------------------------------------------------------------------------------------------------------
# `eoi` shows the email + password pages (/signin, /signup, /forgot-password) and keeps the session in an HttpOnly refresh cookie set by the backend (AUTH_PROVIDER=eoi there).
# Google ("Continue with Google") appears on those pages when the VITE_OIDC_* settings above are also set. A public switch only; the server decides everything.
# VITE_KOI_AUTH=eoi
