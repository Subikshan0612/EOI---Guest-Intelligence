PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=

# --- AI intelligence engine (optional) ---
# Leave LLM_PROVIDER unset to run with AI intelligence disabled — the
# POST /api/signals/:id/intelligence endpoint will return a clean
# "AI intelligence service is not configured" error instead of failing.
#
# LLM_PROVIDER selects exactly one provider (server-side only; a client can
# never choose this):
#   "gemini"      - Phase 5 Step 4: the real/default path. Node delegates to
#                   the Python AI service (ai-service/), which then calls
#                   Gemini itself. Requires AI_SERVICE_URL below to be
#                   reachable, AND ai-service's own LLM_PROVIDER=gemini +
#                   GEMINI_API_KEY (configured on the Python side, in
#                   ai-service/.env — NOT read from this file for this path).
#                   Node's own GEMINI_API_KEY below is no longer used by this
#                   value; it is kept only so the pre-Step-4 direct Node→
#                   Gemini implementation (backend/src/services/ai/
#                   llmProvider.js) still has what it needs if routing is
#                   ever reverted to it as a rollback.
#   "openai"      - OpenAI chat completions, called directly from Node
#                   (unaffected by the Step 4 change above). Retained as an
#                   optional/future alternative. Requires OPENAI_API_KEY.
#   "test"        - deterministic in-process fixture used only by the
#                   automated test suite. Makes no network call. Never set
#                   this for real use.
#   "test-python" - an alternate, explicit way to reach the same Python
#                   delegation path as "gemini" above (useful for
#                   deterministic Node→Python integration testing without
#                   depending on "gemini" specifically). Requires
#                   AI_SERVICE_URL below.
LLM_PROVIDER=gemini

# LLM_MODEL applies to whichever provider is selected above.
# gemini-2.5-flash is deprecated for new API keys as of this writing (Gemini
# returns 404 NOT_FOUND and recommends gemini-3.6-flash as the replacement —
# confirmed via a real request against this project's key). Verify current
# model availability for your own key at https://aistudio.google.com/apikey
# if this ever needs to change again.
# Gemini default if left blank: gemini-3.6-flash (see note above — prefer
# setting this explicitly rather than relying on the blank-value fallback)
# OpenAI default if left blank: gpt-4o-mini
LLM_MODEL=gemini-3.6-flash

# GEMINI_API_KEY: only used by the pre-Step-4 direct Node→Gemini rollback
# path (llmProvider.js) — NOT read when LLM_PROVIDER=gemini delegates to
# Python (the current default). Set the real key on the Python side instead
# (ai-service/.env's own GEMINI_API_KEY). Never commit a real key here either.
GEMINI_API_KEY=your_gemini_api_key_here

# OPENAI_API_KEY: required only when LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=your_api_key_here

# --- Python AI service ---
# AI_SERVICE_URL: base URL of the ai-service/ FastAPI service. Required when
# LLM_PROVIDER=gemini or LLM_PROVIDER=test-python above (Phase 5 Step 4:
# "gemini" is no longer a direct Node→Gemini call — it needs this service
# reachable). Not required for openai/test.
AI_SERVICE_URL=http://localhost:8000
