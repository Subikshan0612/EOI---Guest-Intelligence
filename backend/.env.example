PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=

# --- Phase 4: AI intelligence engine (optional) ---
# Leave LLM_PROVIDER unset to run with AI intelligence disabled — the
# POST /api/signals/:id/intelligence endpoint will return a clean
# "AI intelligence service is not configured" error instead of failing.
#
# LLM_PROVIDER selects exactly one provider (server-side only; a client can
# never choose this):
#   "gemini"      - Google Gemini API. Free tier available; the primary
#                   provider for local development. Requires GEMINI_API_KEY.
#   "openai"      - OpenAI chat completions. Retained for future/optional use.
#                   Requires OPENAI_API_KEY.
#   "test"        - deterministic in-process fixture used only by the
#                   automated test suite. Makes no network call. Never set
#                   this for real use.
#   "test-python" - Phase 5 Step 3 only: routes to the Python AI service's
#                   deterministic stub (see ai-service/) instead of any
#                   in-process provider. Requires AI_SERVICE_URL below. Not
#                   the default, not used for real AI generation yet.
LLM_PROVIDER=gemini

# LLM_MODEL applies to whichever provider is selected above.
# gemini-2.5-flash is deprecated for new API keys as of this writing (Gemini
# returns 404 NOT_FOUND and recommends gemini-3.6-flash as the replacement —
# confirmed via a real request against this project's key). Verify current
# model availability for your own key at https://aistudio.google.com/apikey
# if this ever needs to change again.
# Gemini default if left blank: gemini-3.6-flash (see note above — prefer
# setting this explicitly rather than relying on the blank-value fallback)
# OpenAI default if left blank: gpt-4o-mini
LLM_MODEL=gemini-3.6-flash

# GEMINI_API_KEY: required when LLM_PROVIDER=gemini. Get a free-tier key at
# https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here

# OPENAI_API_KEY: required only when LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=your_api_key_here

# --- Phase 5 Step 3: Python AI service (optional, deterministic only) ---
# AI_SERVICE_URL: base URL of the ai-service/ FastAPI service. Only read
# when LLM_PROVIDER=test-python above. Not required for gemini/openai/test.
AI_SERVICE_URL=http://localhost:8000
