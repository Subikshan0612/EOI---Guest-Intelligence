PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=

# --- AI intelligence engine (optional) ---
# Leave LLM_PROVIDER unset to run with AI intelligence disabled — the
# POST /api/signals/:id/intelligence endpoint will return a clean
# "AI intelligence service is not configured" error instead of failing.
#
# LLM_PROVIDER selects exactly one provider (server-side only; a client can
# never choose this):
#   "gemini"      - the real/default path. Node delegates to the Python AI
#                   service (ai-service/), which then calls Gemini itself.
#                   Requires AI_SERVICE_URL below to be reachable, AND
#                   ai-service's own LLM_PROVIDER=gemini + GEMINI_API_KEY
#                   (configured on the Python side, in ai-service/.env only —
#                   Node has no Gemini client and reads no Gemini key at all;
#                   see backend/src/services/ai/llmProvider.js, which as of
#                   Phase 5 Step 5 contains no Gemini code whatsoever).
#   "openai"      - OpenAI chat completions, called directly from Node via
#                   llmProvider.js (never touches ai-service). Retained as an
#                   optional/future alternative. Requires OPENAI_API_KEY.
#   "test"        - deterministic in-process fixture used only by the
#                   automated test suite. Makes no network call. Never set
#                   this for real use.
#   "test-python" - an alternate, explicit way to reach the same Python
#                   delegation path as "gemini" above (useful for
#                   deterministic Node→Python integration testing without
#                   depending on "gemini" specifically). Requires
#                   AI_SERVICE_URL below.
LLM_PROVIDER=gemini

# LLM_MODEL applies only to "openai" (default if left blank: gpt-4o-mini).
# It has no effect when LLM_PROVIDER=gemini/test-python — the model actually
# used by Gemini is controlled entirely by ai-service's own LLM_MODEL (see
# ai-service/.env.example), since Node never constructs the Gemini request.
LLM_MODEL=gpt-4o-mini

# OPENAI_API_KEY: required only when LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=your_api_key_here

# --- Python AI service ---
# AI_SERVICE_URL: base URL of the ai-service/ FastAPI service. Required when
# LLM_PROVIDER=gemini or LLM_PROVIDER=test-python above ("gemini" is not a
# direct Node->Gemini call — it needs this service reachable). Not required
# for openai/test.
AI_SERVICE_URL=http://localhost:8000
