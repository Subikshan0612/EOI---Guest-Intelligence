PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# MongoDB. LOCAL development: mongodb://127.0.0.1:27017/koi (put it in your git-ignored backend/.env).
# ATLAS / staging / production: mongodb+srv://<db-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
#   supplied through the hosting platform's secret store, NEVER committed, NEVER a VITE_* variable. The database name is required
#   outside development. See docs/MONGODB_ATLAS_PHASE41.md.
MONGODB_URI=

# --- AI intelligence engine (optional) ---
# Leave LLM_PROVIDER unset to run with AI intelligence disabled — the
# POST /api/intelligence/analyze/:signalId endpoint will return a clean
# "AI intelligence service is not configured" error instead of failing.
#
# LLM_PROVIDER selects exactly one provider (server-side only; a client can
# never choose this):
#   "gemini"      - the real/default path. Node delegates to the Python AI
#                   service (ai-service/), which then calls Gemini itself.
#                   Requires AI_SERVICE_URL below to be reachable, AND
#                   ai-service's own LLM_PROVIDER=gemini + GEMINI_API_KEY
#                   (configured on the Python side, in ai-service/.env only —
#                   Node has no Gemini client and reads no Gemini key at all).
#   "openai" / "test" - NO LONGER generation providers (Phase 24). The only
#                   generation path is Intelligence V1, which needs the
#                   Python AI service; with these values it answers 503.
#   "test-python" - an alternate, explicit way to reach the same Python
#                   delegation path as "gemini" above (useful for
#                   deterministic Node→Python integration testing without
#                   depending on "gemini" specifically). Requires
#                   AI_SERVICE_URL below.
LLM_PROVIDER=gemini

# LLM_MODEL has no effect on the Node side (Phase 24: no Node-level provider remains) — the model actually
# used by Gemini is controlled entirely by ai-service's own LLM_MODEL (see
# ai-service/.env.example), since Node never constructs the Gemini request.
# LLM_MODEL=

# OPENAI_API_KEY: unused (the direct Node->OpenAI path was removed in Phase 24). Never commit a real key.
# OPENAI_API_KEY=

# --- Python AI service ---
# AI_SERVICE_URL: base URL of the ai-service/ FastAPI service. Required when
# LLM_PROVIDER=gemini or LLM_PROVIDER=test-python above ("gemini" is not a
# direct Node->Gemini call — it needs this service reachable).
#
# Phase 6E: this same URL also serves POST /v1/embeddings (see
# backend/src/services/knowledgeEmbeddingService.js) — no separate embedding
# service URL exists; it is one Python service with more than one endpoint.
AI_SERVICE_URL=http://localhost:8000

# --- Knowledge visibility (TEMPORARY development fallback) ---
# EOI has no authentication yet. Until it does, THIS server-side setting is
# the knowledge visibility level every request is authorized for:
#   guest (default) < staff < restricted
# It is read from the server's environment only - never from a request - and
# it applies to every caller of the process alike, so it is NOT a real
# authorization boundary between users. An unset/invalid value means "guest".
# KNOWLEDGE_DEV_AUTHORIZED_LEVEL=guest

# --- Authentication foundation (DEVELOPMENT / TEST ONLY) ---
# EOI verifies "Authorization: Bearer <token>" through a provider-agnostic
# verifier (src/auth/). No real identity provider is wired up yet, and nothing
# in the API requires authentication yet. With no verifier configured, any
# bearer request fails closed (503).
#
# AUTH_TOKEN_VERIFIER=stub switches on the DEVELOPMENT stub verifier, which
# accepts HS256 tokens signed with AUTH_STUB_SECRET (16+ characters). It is not
# an identity provider and is refused when NODE_ENV=production.
# AUTH_TOKEN_VERIFIER=stub
# AUTH_STUB_SECRET=

# Error internals (name, original message, stack) are added to error responses ONLY when this is exactly "true"
# AND NODE_ENV is not production. Omitted or any other value = hidden (fail closed). Never set it in a shared or production environment.
# KOI_EXPOSE_ERROR_DETAILS=false

# --- Phase 21 runtime hardening (all optional; see docs/RUNTIME_HARDENING_PHASE21.md) -------------------------------
# NODE_ENV must be EXACTLY development or test to allow the development token verifier / debug details. Unset or unknown = refused.
# KOI_ACTION_REVIEW_REQUIRES_SECOND_PERSON=false   # "true": an Action proposal must be reviewed by a different user than its proposer (Phase 49 default: the proposer may confirm their own, since nothing executes)
# KOI_RATE_LIMIT_ENABLED=true          # only the string "false" disables limiting
# KOI_RATE_LIMIT_WINDOW_MS=60000
# KOI_RATE_LIMIT_ANON_MAX=60           # no Authorization header, per client address
# KOI_RATE_LIMIT_IP_MAX=900            # every request, per client address
# KOI_RATE_LIMIT_USER_MAX=300          # authenticated, per verified identity
# KOI_RATE_LIMIT_WRITE_MAX=60          # POST/PATCH/DELETE, per identity
# KOI_RATE_LIMIT_AI_MAX=10             # AI-reaching routes, per identity
# KOI_RATE_LIMIT_AI_WORKSPACE_MAX=30   # AI-reaching routes, per verified workspace
# KOI_RATE_LIMIT_IMPORT_MAX=5          # imports, per identity
# KOI_TRUST_PROXY=                     # hop count; X-Forwarded-For is ignored unless set
# KOI_HEADERS_TIMEOUT_MS=15000
# KOI_REQUEST_TIMEOUT_MS=60000
# KOI_SOCKET_TIMEOUT_MS=120000
# KOI_AI_TIMEOUT_MS=20000          # per-call timeout of retrieval / embedding calls to the AI service (Workstream 5C: no longer sets the analysis wait)
# KOI_AI_ANALYSIS_TIMEOUT_MS=65000 # how long Node waits for the AI service's ANALYSIS call; default = the 60 s analysis ceiling + 5 s; must exceed the AI service's LLM_ANALYSIS_TIMEOUT_MS; leave unset
# KOI_JSON_BODY_LIMIT_BYTES=102400
# KOI_IMPORT_MAX_ROWS=5000
# KOI_IMPORT_MAX_COLUMNS=50
# KOI_IMPORT_MAX_FIELD_LENGTH=1000
# KOI_IMPORT_MAX_RECORD_BYTES=20000

# --- Phase 23 authentication (see docs/AUTHENTICATION_OIDC_PHASE23.md) --------------------------------------------
# AUTH_PROVIDER=oidc                # oidc (production-capable) | stub (development/test only). Production REQUIRES oidc and refuses to start otherwise.
# OIDC_ISSUER=                      # the exact `iss` of your tokens (https)
# OIDC_AUDIENCE=                    # the audience of tokens issued for this API (comma-separated allowed)
# OIDC_JWKS_URI=                    # optional; default: discovered from OIDC_ISSUER/.well-known/openid-configuration
# OIDC_ALGORITHMS=RS256,ES256       # asymmetric only
# OIDC_CLOCK_TOLERANCE_SECONDS=60
# OIDC_REQUIRED_TYP=                # e.g. at+jwt
# --- Phase 45C self-registration (default OFF). When "true", a verified identity with no EOI account may set up its OWN account: a new workspace named by the
# person and an admin membership in THAT workspace only (never in an existing workspace). Off: access to any workspace is granted by an administrator.
# KOI_SELF_REGISTRATION=false
# --- Phase 45B.4 server-side code exchange (only for a provider that REQUIRES a client secret at its token endpoint, e.g. a Google 'Web application' client)
# All three or none. The secret stays HERE (server side): never in frontend/.env, never a VITE_* variable, never committed.
# OIDC_EXCHANGE_CLIENT_ID=          # the OAuth client id; must also be listed in OIDC_AUDIENCE (Google: the ID token's audience is the client id)
# OIDC_EXCHANGE_CLIENT_SECRET=      # the client secret (secret store in production)
# OIDC_EXCHANGE_REDIRECT_URIS=      # comma-separated EXACT redirect URIs, e.g. http://localhost:5175/ (https in production)
# Register a real user: node scripts/provision-user.mjs --subject <sub> --workspace <id|slug> --role <role>

# --- Unified sign-in: email + password AND Google behind ONE EOI session (Phase 46) ---------------------------------------------------------------------
# AUTH_PROVIDER=eoi turns it on (instead of `oidc`, where a provider token is the API bearer). Google (the OIDC_* + OIDC_EXCHANGE_* settings above) is then OPTIONAL
# and only an identity source used by the code exchange. See backend/docs/UNIFIED_AUTH_PHASE46.md.
# AUTH_PROVIDER=eoi
# Signs EOI access tokens (HS256). At least 32 characters of high entropy. SECRET: a secret-manager value in production, never committed, never a VITE_* variable.
# KOI_SESSION_SECRET=
# KOI_ACCESS_TOKEN_TTL_SECONDS=600
# KOI_REFRESH_TTL_DAYS=14
# The refresh cookie `koi_rt` is HttpOnly, Path=/api/auth. Production requires Secure (HTTPS). SameSite=none only when the frontend and the API are on DIFFERENT sites.
# KOI_COOKIE_SAMESITE=lax
# KOI_COOKIE_SECURE=
# scrypt cost (log2 N, default 16). Lower values are honoured in development/test only.
# KOI_PASSWORD_SCRYPT_LOG_N=16

# --- Email delivery. Required for AUTH_PROVIDER=eoi in production (the server refuses to start without a valid transport). ---------------------------------------
# Two real transports: Resend's HTTPS API (use this where outbound SMTP is blocked, for example Render Free: ports 25/465/587) or SMTP through Nodemailer.
# RESEND (HTTPS, port 443). No SMTP variable is read in this mode. Select it explicitly:
# KOI_EMAIL_TRANSPORT=resend
# RESEND_API_KEY=                   # SECRET: server-side only, a secret-manager value in production, never committed, never a VITE_* variable. Starts with re_
# MAIL_FROM=EOI <no-reply@your-verified-domain.example>   # the address must be on a domain verified in Resend (Resend dashboard -> Domains)
# SMTP (Phase 46.1): Nodemailer. Used when KOI_EMAIL_TRANSPORT=smtp or implied by SMTP_HOST.
# CLIENT_URL (above) is the base of every verification / reset link: in production it must be the public https:// frontend URL (never localhost).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                     # 587 = STARTTLS (mandatory upgrade, no plaintext fallback); 465 = implicit TLS (also set SMTP_SECURE=true)
# SMTP_SECURE=false                 # true for 465. Server certificates are ALWAYS verified: there is no setting to turn that off.
# SMTP_USER=
# SMTP_PASSWORD=                    # SECRET: server-side only, a secret-manager value in production, never committed, never a VITE_* variable
# MAIL_FROM=EOI <no-reply@example.com>
# KOI_EMAIL_TRANSPORT=smtp          # optional: implied by SMTP_HOST
# DEVELOPMENT / TEST ONLY: instead of sending, write the links to backend/.dev-outbox/outbox.jsonl (git-ignored; read with `node scripts/dev-outbox.mjs`). Refused in production
# and in an unset/unknown NODE_ENV; it is never a fallback for a missing SMTP configuration.
# KOI_EMAIL_TRANSPORT=outbox
# DEVELOPMENT / TEST ONLY: allow a plaintext SMTP connection to a LOCAL capture server (e.g. MailHog). Refused in production.
# SMTP_REQUIRE_TLS=false

# Phase 51: optional shared credential for the AI service. Set the SAME value here and in ai-service/.env (a long random string; never a VITE_ variable). With it, the AI service refuses
# every request that does not carry it, which matters when the hosting platform cannot keep the service on a private network. Unset = network isolation only (a startup warning in production).
# AI_SERVICE_TOKEN=
