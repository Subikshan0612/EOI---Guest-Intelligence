# --- KOI AI service environment ---
# Copy to ai-service/.env for local development. Do not commit real values.
#
# Phase 5 Step 2: none of these are used to call Gemini yet — the service
# only exposes a health endpoint at this step. They exist so configuration
# is already wired the same way it will be once model invocation moves here.
# Starting the service never requires GEMINI_API_KEY to be set.

AI_SERVICE_PORT=8000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
REQUEST_TIMEOUT_MS=20000
