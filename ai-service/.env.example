# --- KOI AI service environment ---
# Copy to ai-service/.env for local development. Do not commit real values.
#
# Phase 5 Step 4: LLM_PROVIDER now actually selects behavior.
#   "test"   - deterministic stub, no network call, no key required. This is
#              the code's own default when no .env is present at all, so a
#              freshly-cloned service never attempts a real call by accident.
#   "gemini" - real Gemini generation via the official google-genai SDK.
#              Requires GEMINI_API_KEY.
# Starting the service never requires GEMINI_API_KEY to be set — it is only
# read when LLM_PROVIDER=gemini.

AI_SERVICE_PORT=8000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
REQUEST_TIMEOUT_MS=20000
