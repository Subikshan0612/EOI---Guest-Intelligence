# --- KOI AI service environment ---
# Copy to ai-service/.env for local development. Do not commit real values.
#
# Phase 5 Step 4: LLM_PROVIDER now actually selects behavior.
#   "test"   - deterministic stub, no network call, no key required. This is
#              the code's own default when no .env is present at all, so a
#              freshly-cloned service never attempts a real call by accident.
#   "gemini" - real Gemini generation via the official google-genai SDK.
#              Requires GEMINI_API_KEY.
# Starting the service never requires GEMINI_API_KEY to be set — it is only
# read when LLM_PROVIDER=gemini.

AI_SERVICE_PORT=8000
LLM_PROVIDER=gemini
# Phase 34A-B: with LLM_PROVIDER=gemini this MUST be exactly the approved model; any other value (including
# gemini-3.6-flash, a -preview id or a *-latest alias) makes the service refuse to start. See app/provider_policy.py.
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
REQUEST_TIMEOUT_MS=20000
# Workstream 5C: the deadline of the Gemini ANALYSIS call, separate from REQUEST_TIMEOUT_MS above (which keeps bounding embedding at <= 20 s). 1..60000 ms; Node waits
# 65 s for it by default and answers the browser after about 25 s regardless (the attempt continues; the page reads its status). See backend/docs/AI_PROVIDER_HYBRID_5C_IMPLEMENTATION.md.
# LLM_ANALYSIS_TIMEOUT_MS=

# Phase 6E: embeddings are a separate concern from intelligence generation
# above, with their own independent provider switch — same GEMINI_API_KEY,
# different setting. "test" (deterministic, no network call, no key) is the
# code's own default for the exact same reason LLM_PROVIDER defaults to it.
#   "test"   - deterministic stub. No network call, no key required.
#   "gemini" - real embeddings via the official google-genai SDK
#              (models.embed_content). Requires GEMINI_API_KEY.
EMBEDDING_PROVIDER=gemini
# gemini-embedding-001 is the current generally-available, text-only Gemini
# embedding model. A newer gemini-embedding-2 also exists but is multimodal
# and drops the task_type parameter this service relies on — unnecessary
# surface for embedding plain text chunks.
EMBEDDING_MODEL=gemini-embedding-001
# Maximum number of texts accepted in one /v1/embeddings request. Node may
# send multiple batches for a document with more chunks than this.
EMBEDDING_BATCH_SIZE=20

# Phase 6F: maximum number of candidates accepted in one
# POST /v1/vector-similarity request (the cosine-similarity primitive — not
# the Phase 6G retrieval endpoint). A request over this limit is rejected
# outright, never silently truncated. No API key required; this endpoint
# never calls a provider.
SIMILARITY_MAX_CANDIDATES=200

# Phase 51: optional service credential. When set, every endpoint except /v1/health requires the X-KOI-Service-Token header (the Node backend sends it from its own AI_SERVICE_TOKEN),
# and /docs, /redoc and /openapi.json are not served. Set the SAME value on the backend. Unset = previous behaviour (isolate the service on a private network).
# AI_SERVICE_TOKEN=
